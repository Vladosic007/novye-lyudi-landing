# Скопируйте в .env.local для локального запуска (vercel dev),
# а на Vercel эти переменные добавит сама интеграция Upstash (кроме ADMIN_PASSWORD).

# ─── Upstash Redis (хранилище заявок) ─────────────────────────
# Vercel → Storage → Upstash подставит их автоматически.
# Код читает и такие имена, и KV_REST_API_URL / KV_REST_API_TOKEN.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxСЕКРЕТxxxx

# ─── Админка ──────────────────────────────────────────────────
# Пароль для входа на /admin — задайте вручную в Vercel
ADMIN_PASSWORD=придумайте-надёжный-пароль

# ─── Почта (mail.ru SMTP) — дублирование заявок на e-mail ─────
MAIL_USER=partia_new@mail.ru
MAIL_PASS=пароль-для-внешних-приложений-из-mail.ru
MAIL_TO=partia_new@mail.ru

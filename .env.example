# ─── Google Sheets (для записи заявок, этап Ф2) ───────────────────────────
# Скопируйте этот файл в .env.local для локального запуска,
# а на Vercel добавьте те же значения в Project → Settings → Environment Variables.

# E-mail сервисного аккаунта Google
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Приватный ключ сервисного аккаунта (в кавычках, \n оставить как есть)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID Google-таблицы (из ссылки: docs.google.com/spreadsheets/d/<ЭТОТ_ID>/edit)
GOOGLE_SHEET_ID=your-spreadsheet-id
